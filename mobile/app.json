{
  "expo": {
    "name": "BarberPro",
    "slug": "barberpro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barberpro",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#312E38",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.arthurfrollini.barberpro"
    },
    "android": {
      "package": "dev.arthurfrollini.barberpro",
      "adaptiveIcon": {
        "backgroundColor": "#312E38",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para mostrar as barbearias perto de você."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#312E38",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF9000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "70098917-cb2e-4761-bede-bb618e9e3153"
      }
    },
    "owner": "arthurfrollini"
  }
}
