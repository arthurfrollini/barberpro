# Copy to .env. The values below match docker-compose.yml when the API runs on the host
# (npm run dev); inside compose, the api service overrides the three hosts.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://barberpro:barberpro@localhost:5442/barberpro
REDIS_URL=redis://localhost:6390
SMTP_URL=smtp://localhost:1025
# at least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
PUBLIC_URL=http://localhost:4000
